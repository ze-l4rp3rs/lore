# Company Brain Environment Configuration
# Copy this to .env and fill in your actual values

# LLM API Keys (at least one required)
GROQ_API_KEY=sk_your_groq_key_here
ANTHROPIC_API_KEY=sk_your_claude_key_here
GEMINI_API_KEY=your_gemini_key_here

# LLM Selection
# Used when several keys are set and there is no terminal to ask on. Options: groq, claude, gemini
DEFAULT_PROVIDER=groq
